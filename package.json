  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:direct": "python -m pytest tests/direct -q",
    "preflight": "python scripts/preflight.py",
    "verify": "npm run preflight && npm run test:direct && npm run typecheck && npm run lint && npm run build",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:studionet": "node scripts/exercise-studionet.mjs",
    "test:source": "python -m pytest tests/direct/test_contract_source.py tests/direct/test_reference_invariants.py tests/direct/test_frontend_source.py -q"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
